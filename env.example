# =========================
# DubzChain Public Testnet env.example
# Phase 10.3
# =========================

# Network profile
DUBZ_NETWORK_PROFILE=testnet

# Node ports
DUBZ_P2P_PORT=3101
DUBZ_RPC_PORT=4101

# Host binding
DUBZ_P2P_HOST=0.0.0.0
DUBZ_RPC_HOST=0.0.0.0

# Public advertise URL
DUBZ_ADVERTISE_URL=wss://seed1.dubzchain.net:3101

# Public seeds
DUBZ_PUBLIC_SEEDS=wss://seed1.dubzchain.net:3101,wss://seed2.dubzchain.net:3101

# RPC auth
DUBZ_RPC_API_KEY=change-this-testnet-api-key

# TLS / secure websocket
DUBZ_P2P_TLS_CERT=./certs/fullchain.pem
DUBZ_P2P_TLS_KEY=./certs/privkey.pem

# Checkpoint signing
DUBZ_CHECKPOINT_PUBLIC_KEY_FILE=./certs/testnet-checkpoint-public.pem
DUBZ_CHECKPOINT_PRIVATE_KEY_FILE=./certs/testnet-checkpoint-private.pem

# Explorer
DUBZ_EXPLORER_PUBLIC_URL=https://explorer.dubzchain.net
DUBZ_EXPLORER_CORS=true

# Storage
DUBZ_STORAGE_MODE=pruned
DUBZ_PRUNE_RETENTION_WINDOW=2016

# Telemetry / metrics
DUBZ_TELEMETRY_ENABLED=true
DUBZ_TELEMETRY_MODE=local
DUBZ_METRICS_ENABLED=true

# Mining
DUBZ_AUTOMINE=false
DUBZ_MINE_EMPTY=false
DUBZ_MINE_INTERVAL=15000
DUBZ_MINE_YIELD=20000